# Template for backend/.env — copy it, fill in YOUR OWN values, and never commit the copy.
# (.env is gitignored and excluded from the Docker image; values are injected at runtime.)
# Required: MONGODB_URI (your MongoDB Atlas connection string) and JWT_SECRET
#   generate one with: openssl rand -hex 32
# SquadPlanner team members don't need this file: secrets come from Infisical (see docs/DOCKER.md).
# Never add RUN_LIVE_INTEGRATION here; it opts into spending live API quota and belongs on the
# command line only.

MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SMTP_USER=
SMTP_PASSWORD=

# Optional. Fallback destination photography when Wikipedia has no image.
# Leave blank to use Wikipedia only.
UNSPLASH_ACCESS_KEY=

# Sent in the User-Agent for Wikipedia image lookups. Wikimedia's robot policy 403s
# requests with no contactable identifier. A project URL is enough.
WIKIMEDIA_CONTACT=https://github.com/Vignesh-1822/squadplanner-ai

# Public origin of THIS api. Used to build absolute URLs for manually added destination
# photos in data/destination_images/. Set to the deployed backend URL in production.
PUBLIC_BASE_URL=http://localhost:8000
LLM_PROVIDER=
ANTHROPIC_API_KEY=""
GROQ_API_KEY=
SERPAPI_KEY=""
GOOGLE_PLACES_API_KEY=""
GOOGLE_ROUTES_API_KEY=""
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=squadplanner
SERPAPI_MONTHLY_HARD_LIMIT=200
EVALS_TOOL_MODE=off
EVALS_LLM_MODE=off