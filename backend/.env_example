# Template for backend/.env — copy it, fill in YOUR OWN values, and never commit the copy.
# (.env is gitignored and excluded from the Docker image; values are injected at runtime.)
# Required: MONGODB_URI (your MongoDB Atlas connection string) and JWT_SECRET
#   generate one with: openssl rand -hex 32

MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SMTP_USER=
SMTP_PASSWORD=
LLM_PROVIDER=
ANTHROPIC_API_KEY=""
GROQ_API_KEY=
SERPAPI_KEY=""
GOOGLE_PLACES_API_KEY=""
GOOGLE_ROUTES_API_KEY=""
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=squadplanner
SERPAPI_MONTHLY_HARD_LIMIT=200
EVALS_TOOL_MODE=off
EVALS_LLM_MODE=off